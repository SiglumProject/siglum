{
  "name": "siglum-engine",
  "version": "0.1.0",
  "description": "The fastest browser-based LaTeX compiler - TeX Live 2025 in WebAssembly with lazy loading and CTAN package resolution",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./compiler": "./src/compiler.js",
    "./bundles": "./src/bundles.js",
    "./ctan": "./src/ctan.js",
    "./storage": "./src/storage.js",
    "./incremental": "./src/incremental/index.js"
  },
  "files": [
    "src/",
    "busytex.js",
    "busytex.wasm",
    "packages/bundles/"
  ],
  "scripts": {
    "dev": "bun serve-local.ts",
    "build:worker": "cp src/worker.js ../webtex/siglum-ui/app/public/worker.js && echo 'Copied worker.js to siglum-ui'",
    "api": "cd cloudflare && bunx wrangler@3.114.16 dev --port 8787 --remote",
    "proxy": "cd packages && bun run ctan-proxy.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiglumProject/siglum-engine.git"
  },
  "keywords": [
    "latex",
    "tex",
    "pdf",
    "wasm",
    "webassembly",
    "browser",
    "compilation"
  ],
  "author": "Siglum Project",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SiglumProject/siglum-engine/issues"
  },
  "homepage": "https://github.com/SiglumProject/siglum-engine#readme",
  "dependencies": {
    "@siglum/filesystem": "file:../siglum-filesystem",
    "blake3-wasm": "2.1.5",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "xzwasm": "^0.1.2"
  }
}
