# Dependencies
node_modules/
bun.lock

# BusyTeX WASM binaries (build from submodule or download)
busytex.js
busytex.wasm

# Build artifacts
dist/
types/
*.log
*.txt

# Compressed WASM (deploy artifact)
busytex.wasm.br

# Host-specific deploy adapters live outside the hosting-agnostic engine.
# cloudflare/ is one such adapter (a wrangler project): it consumes the engine's
# emitted artifacts but must not become a dependency of the engine, so it is not
# tracked here. (Version it in its own repo.)
cloudflare/
wrangler.toml
.wrangler/

# GitHub Actions (not configured yet)
.github/

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code
.claude/

# Bundles (download from CDN or releases)
packages/bundles/*.data.gz
packages/bundles/*.data.br
packages/bundles/*.raw
packages/bundles/*.meta.json
packages/bundles/registry.json

# Normalized-artifact cache (regeneratable: `bun scripts/prebuild-packages.js`,
# shipped to R2 / releases — same as the CTAN cache and bundle data above)
packages/bundles/prebuilt/

# One-off migration scripts
packages/update-bundles-tl2026.ts

# CTAN cache (regeneratable)
packages/cache/

# Local development
packages/ctan-packages/
packages/local-packages/

