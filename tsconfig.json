{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./types",
    "outDir": "./types",
    "strict": false,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "module": "ESNext",
    "target": "ESNext"
  },
  "include": ["src/**/*.js"],
  "exclude": ["src/worker.js"]
}
